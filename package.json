{
  "name": "json-log-viewer",
  "displayName": "JSON Log Viewer",
  "description": "Beautiful structured log viewer for debugging. Automatically formats JSON logs with syntax highlighting, filtering, and search.",
  "version": "0.0.3",
  "publisher": "tmontdev",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tmontdev/json-log-viewer"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers",
    "Formatters"
  ],
  "keywords": [
    "json",
    "logs",
    "slog",
    "debug",
    "console",
    "structured-logging"
  ],
  "activationEvents": [
    "onDebug"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-log-viewer.clearLogs",
        "title": "JSON Log Viewer: Clear Logs"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "json-log-viewer-panel",
          "title": "JSON Log Viewer",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "json-log-viewer-panel": [
        {
          "id": "json-log-viewer.logView",
          "name": "JSON LOg Viewer",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "json-log-viewer.logView",
        "contents": "No logs yet.\n\nStart debugging to see formatted structured logs.\n\n[Start Debugging](command:workbench.action.debug.start)"
      }
    ],
    "configuration": {
      "title": "JSON Log Viewer",
      "properties": {
        "jsonLogViewer.collapseJSON": {
          "type": "boolean",
          "default": true,
          "description": "Show JSON collapsed by default (click to expand)"
        },
        "jsonLogViewer.showRawJSON": {
          "type": "boolean",
          "default": false,
          "description": "Show the raw JSON log below each formatted entry"
        },
        "jsonLogViewer.autoScroll": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scroll to the latest log entry"
        },
        "jsonLogViewer.theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "default": "auto",
          "description": "Theme for the log viewer (auto uses VSCode theme)"
        },
        "jsonLogViewer.messageKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "message",
            "msg"
          ],
          "description": "List of keys to check for the log message content (in order of priority)"
        },
        "jsonLogViewer.timestampKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "timestamp",
            "ts",
            "@timestamp"
          ],
          "description": "List of keys to check for the log timestamp (in order of priority)"
        },
        "jsonLogViewer.levelKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "level"
          ],
          "description": "List of keys to check for the log level (in order of priority)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-webview",
    "copy-webview": "mkdir -p dist/webview && cp src/webview/*.html src/webview/*.css src/webview/*.js dist/webview/",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
